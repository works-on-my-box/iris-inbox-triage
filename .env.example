# Copy to .env (git-ignored). Docker Compose passes these to IRIS.

# The agent reads it with @{env:GEMINI_API_KEY}; the free tier of Google AI Studio is enough.
GEMINI_API_KEY=your-google-ai-studio-key

# Mailbox the production polls. Leave all of these unset to use the test mail server from docker-compose.yml
# (triage@triage.local, password triage). For a real mailbox, for example Gmail over IMAP with an app password:
# MAIL_HOST=imap.gmail.com
# MAIL_TLS=1
# MAIL_USER=you@gmail.com
# MAIL_PASSWORD=your-app-password
# Unread messages are marked as read once triaged; the IMAP port defaults to 993 with TLS, 143 without (MAIL_IMAP_PORT).
# POP3 instead of IMAP (the POP3 service deletes each message from the server after reading it):
# MAIL_PROTOCOL=pop3
# MAIL_HOST=pop.gmail.com
# MAIL_POP3_PORT=995
# Where draft replies are mailed for review, and the SMTP server used for that (same credentials):
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=465
# DRAFTS_TO=you@gmail.com

# Optional: a different AI Hub image tag from the Early Access Program portal.
# IRIS_IMAGE=docker.iscinternal.com/docker-intersystems/intersystems/iris-community:2026.3.0AI.154.0
